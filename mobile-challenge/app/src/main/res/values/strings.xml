<resources>
    <string name="app_name">Mobile Challenge</string>
    <!-- %1$s is the scenario name, which is only shown in the mock build. -->
    <string name="backend_mock">Mock data: %1$s</string>
    <string name="scenario_menu">Scenario</string>
    <string name="backend_real">Using navvis.com</string>

    <string name="state_ready">Streams numbers and inputs from the server and shows them by section.</string>
    <string name="start">START</string>
    <string name="state_loading">Loading numbers…</string>
    <string name="state_empty">No numbers available.</string>
    <!-- Shown when numbers arrived but none of them could be shown. -->
    <plurals name="state_empty_all_skipped">
        <item quantity="one">No valid numbers. %d value was skipped.</item>
        <item quantity="other">No valid numbers. %d values were skipped.</item>
    </plurals>
    <string name="state_error">Couldn\'t load numbers</string>
    <string name="retry">Retry</string>
    <string name="banner_numbers_failed">Couldn\'t load more numbers</string>
    <string name="banner_inputs_failed">Couldn\'t load more inputs</string>

    <!-- Reasons shown under an error. Plain words, no exception names. -->
    <string name="error_server">Server error (%1$d)</string>
    <string name="error_busy">The server is busy, try again in a moment</string>
    <string name="error_request_failed">Request failed (%1$d)</string>
    <string name="error_timeout">The server took too long to answer</string>
    <string name="error_no_connection">No connection</string>
    <string name="error_unreadable">The server sent data the app couldn\'t read</string>

    <!-- Footer pieces, joined with commas: "200 numbers shown, 3 skipped, 97 results". -->
    <plurals name="summary_numbers_shown">
        <item quantity="one">%d number shown</item>
        <item quantity="other">%d numbers shown</item>
    </plurals>
    <string name="summary_skipped">%d skipped</string>
    <plurals name="summary_results">
        <item quantity="one">%d result</item>
        <item quantity="other">%d results</item>
    </plurals>

    <!-- Same format as the challenge's example, for example "result=03". -->
    <string name="row_result">result=%1$s</string>
    <!-- Read out by screen readers for the spinner on a row that is still waiting for its result. -->
    <string name="row_pending">Computing result</string>
    <string name="row_error_missing_input">missing input</string>
    <string name="row_error_invalid_input">invalid input</string>
    <string name="row_error_timed_out">timed out</string>
</resources>
